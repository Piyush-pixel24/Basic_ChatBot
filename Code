# 🤖 Advanced Chatbot in Python

import random
import datetime

# Bot responses
greetings = ["Hello!", "Hi there!", "Hey!", "Greetings!"]
how_are_you = [
    "I'm doing great!",
    "All good here!",
    "I'm fine and ready to help!"
]

jokes = [
    "Why do programmers prefer dark mode? Because light attracts bugs! 😂",
    "Why did the computer get cold? Because it left its Windows open! 😂",
    "Why was the Python developer calm? Because he had good exception handling! 😂"
]

print("=" * 50)
print("🤖 Advanced Python Chatbot")
print("Type 'bye' to exit.")
print("=" * 50)

user_name = input("Before we start, what's your name? ")

print(f"Bot: Nice to meet you, {user_name}!\n")

while True:
    user_input = input(f"{user_name}: ").lower()

    # Greeting
    if any(word in user_input for word in ["hello", "hi", "hey"]):
        print("Bot:", random.choice(greetings))

    # Asking bot status
    elif "how are you" in user_input:
        print("Bot:", random.choice(how_are_you))

    # Asking time
    elif "time" in user_input:
        current_time = datetime.datetime.now().strftime("%I:%M %p")
        print(f"Bot: Current time is {current_time}")

    # Asking date
    elif "date" in user_input:
        current_date = datetime.datetime.now().strftime("%d-%m-%Y")
        print(f"Bot: Today's date is {current_date}")

    # Joke section
    elif "joke" in user_input:
        print("Bot:", random.choice(jokes))

    # Calculator feature
    elif "calculate" in user_input:
        try:
            expression = input("Enter calculation (example: 5 + 3): ")
            result = eval(expression)
            print("Bot: Result =", result)
        except:
            print("Bot: Invalid calculation!")

    # User name
    elif "my name" in user_input:
        print(f"Bot: Your name is {user_name}.")

    # Help command
    elif "help" in user_input:
        print("""
Bot Features:
- Greetings
- Tell Time & Date
- Tell Jokes
- Simple Calculator
- Remember Your Name
- Exit Chat
        """)

    # Exit condition
    elif user_input == "bye":
        print(f"Bot: Goodbye {user_name}! Have a great day 👋")
        break

    # Unknown input
    else:
        print("Bot: Sorry, I didn't understand that.")
